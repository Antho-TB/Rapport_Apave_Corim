# Rapport_Apave_Corim - Variables d'environnement
#
# Junior Tip : depuis la migration du 27/04 (commit "migration vers Azure Key Vault
# et suppression dotenv"), les VRAIS secrets (GEMINI_PROJECT_ID, GEMINI_LOCATION,
# GCP-CREDENTIALS-JSON) ne vivent plus ici. Ils sont recuperes a chaud depuis le
# Key Vault kv-tb-ia-agents-secrets (voir app.py / batch_processor.py). Ce fichier
# sert uniquement de filet de secours local (dev hors-ligne sans acces Azure) et
# de reference pour savoir quelles variables existent dans le projet.
#
# Ne jamais commiter un .env rempli : seul .env.template (valeurs vides) est versionne.

# Utilise uniquement en fallback local si le Key Vault est injoignable.
# En production, ces valeurs viennent du Key Vault, pas de ce fichier.
GEMINI_PROJECT_ID=
GEMINI_LOCATION=

# Chemin d'export Corim fourni par Maxence (voir src/corim_mapping.py).
# Sans ce fichier, les colonnes NUMERO/INTERV_ORIG restent vides a l'import.
CORIM_EXPORT_PATH=IA Apave Corim/Export ITV tests pour Anthony.xlsx

# DWH Sylob (schema apave_corim, voir src/dwh_loader.py et deploy/sql/).
# En prod : credentials recuperes via Key Vault kv-dtpf-prod (compte service
# myreport), ces variables ne servent qu'en fallback local hors VPN/Key Vault.
DWH_KEY_VAULT_NAME=kv-dtpf-prod
PG_HOST=psql-dtpf-psql-prod.postgres.database.azure.com
PG_PORT=5432
PG_DB=dtpf_sylob_prod
PG_USER=
PG_PASSWORD=
